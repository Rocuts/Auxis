# Postgres connection string — Neon pooled endpoint for the live target,
# the docker-compose container locally. Copy real values into .env (never committed).
# For docker-compose, this is the literal value (see docker-compose.yml: the
# container publishes 5433, not 5432):
#   DATABASE_URL=postgresql://tax:tax@localhost:5433/tax
# Note that `python -m tax_tables.migrate` reads the SHELL environment, not
# this file: export DATABASE_URL before running it.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Anthropic API key. Used by the SchemaMapper (all documents) and the
# vision-OCR TableExtractor (scanned input, document 05). Server-side only:
# must never reach a response body, a log line, or the client.
ANTHROPIC_API_KEY=sk-ant-...

# SchemaMapper endpoint/key/model overrides. All optional. The adapter
# always speaks the Anthropic Messages protocol; these choose which endpoint
# answers it. Set the pair below (plus SCHEMA_MAPPER_API_KEY) to route mapping
# through the Vercel AI Gateway, which accepts that protocol on behalf of
# non-Anthropic models; unset, the mapper uses ANTHROPIC_API_KEY against
# api.anthropic.com with claude-opus-5. Prices (USD per million tokens) feed
# per-document cost accounting and must match the configured model.
#
# AS SHIPPED, live and local (ADR 014): the AI Gateway serves
# zai/glm-5.3-flash to the mapper and adjudicator and alibaba/qwen-3-235b to
# the verifier. Direct Anthropic and Bedrock are wired and unfunded here.
#   SCHEMA_MAPPER_BASE_URL=https://ai-gateway.vercel.sh
#   SCHEMA_MAPPER_MODEL=zai/glm-5.3-flash
#   RECORD_VERIFIER_MODEL=alibaba/qwen-3-235b
#SCHEMA_MAPPER_API_KEY=
#SCHEMA_MAPPER_BASE_URL=
#SCHEMA_MAPPER_MODEL=claude-opus-5
#SCHEMA_MAPPER_USD_PER_MTOK_IN=5
#SCHEMA_MAPPER_USD_PER_MTOK_OUT=25
# Cache prices as multiples of the input price. Optional and rarely needed:
# unset, they default from the configured model's provider (Anthropic 0.1x
# read / 1.25x write; z.ai 0.2x read and no published write discount; a
# provider that publishes no cache price bills cached tokens at the full
# input rate rather than borrowing another vendor's discount). Set only to
# correct a model this build's table does not know. See adapters/pricing.py.
#SCHEMA_MAPPER_CACHE_READ_FACTOR=
#SCHEMA_MAPPER_CACHE_WRITE_FACTOR=

# Independent RecordVerifier (ADR 012). All optional: each falls back to the
# SCHEMA_MAPPER_* value, then the SDK's ANTHROPIC_* names. Setting a model
# here is how the verifier runs a cheaper or different-family model than the
# mapper (the mitigation for correlated same-model errors). Prices: explicit
# RECORD_VERIFIER_USD_* always win; SCHEMA_MAPPER_USD_* transfers ONLY while
# the verifier runs the mapper's model — an overridden model without its own
# prices uses the Opus defaults rather than another model's rate. That last
# rule has teeth: SET THE PRICES WHENEVER YOU SET THE MODEL, or a $0.22/Mtok
# verifier is reported at Opus's $5.
#RECORD_VERIFIER_API_KEY=
#RECORD_VERIFIER_BASE_URL=
#RECORD_VERIFIER_MODEL=
#RECORD_VERIFIER_USD_PER_MTOK_IN=
#RECORD_VERIFIER_USD_PER_MTOK_OUT=
#RECORD_VERIFIER_CACHE_READ_FACTOR=
#RECORD_VERIFIER_CACHE_WRITE_FACTOR=
#RECORD_VERIFIER_MAX_OUTPUT_TOKENS=16000

# Review-queue Adjudicator (ADR 012). Same fallback chain as the verifier.
# Items adjudicated at or above the pipeline's auto-resolve threshold (0.9,
# with valid citations) resolve with an audit trail; below it they stay human.
#ADJUDICATOR_API_KEY=
#ADJUDICATOR_BASE_URL=
#ADJUDICATOR_MODEL=
#ADJUDICATOR_USD_PER_MTOK_IN=
#ADJUDICATOR_USD_PER_MTOK_OUT=
#ADJUDICATOR_CACHE_READ_FACTOR=
#ADJUDICATOR_CACHE_WRITE_FACTOR=
#ADJUDICATOR_MAX_OUTPUT_TOKENS=8000

# Shared key required in the X-API-Key header on POST /documents.
API_KEY=change-me

# Bearer secret for the queue-subscriber / cron-sweep endpoints.
CRON_SECRET=change-me

# ---------------------------------------------------------------------------
# Target selection (Phase 3.5). The pipeline is the same code on every target;
# these two variables choose which adapters it composes.
# ---------------------------------------------------------------------------

# Which pixel-licensed extractor handles scanned pages.
#   tesseract  local / docker-compose (needs the tesseract binary + `ocr` extra)
#   vision     Vercel — no system binary can exist there (ADR 010)
#   textract   the AWS design
# An unknown value raises rather than falling back: silently reverting to a
# binary that is not installed would report an empty document at high
# confidence, which is exactly the silent loss anti-goal #8 forbids.
EXTRACTION_OCR_ENGINE=tesseract

# How an accepted upload's pipeline run gets started.
#   none    enqueue only; work begins on the next sweep (local default)
#   vercel  kick POST /internal/sweep immediately, cron as the backstop
JOB_RUNNER=none

# Visibility timeout for a claimed job, in seconds (ADR 009 amendment). A job
# that is still `running` this long after `started_at` is assumed to have lost
# its worker and becomes claimable again — which is the only way the cron
# backstop can see a worker the platform killed at maxDuration.
#
# THE INVARIANT, and it has teeth:
#
#     JOB_LEASE_SECONDS  >=  the function's maxDuration (vercel.json: 1800)
#
# Too long only delays a rescue. TOO SHORT lets the sweep reclaim a job whose
# worker is still alive: two workers map the same document and the run is
# billed twice. `tests/api/test_jobs.py::TestLeaseInvariant` reads vercel.json
# and fails if this ever stops holding.
#JOB_LEASE_SECONDS=1860

# How many times a job may be attempted before it is abandoned as `failed`
# with error.type == "lease_expired_max_attempts". Without a ceiling, a
# document that reliably kills its worker is reclaimed forever and every
# reclaim spends model credit.
#JOB_MAX_ATTEMPTS=3

# Wall-clock ceiling on the post-persistence adjudication pass, in seconds.
# Records are already committed when this runs, and the pass is optional by
# design: an item the adjudicator cannot settle waits for a human. Its
# DURATION, though, is unbounded — one call can spend the adapter's request
# timeout (300 s) and the SDK retries it up to three times — so on
# request-scoped compute a slow queue can consume the whole function budget
# and the job never reaches a terminal state.
#
# Measured on production 2026-08-27: document 01 persisted its records at
# ~360 s and then spent the remainder of a 1800 s invocation adjudicating,
# twice, terminating neither time. Trading a resolved queue item for a
# finished job is the right trade every time — the item was always allowed to
# wait for a human, whereas an unfinished job loses the whole run's
# bookkeeping. Items the pass does not reach are REPORTED as
# `deadline_exceeded`, never silently skipped (anti-goal #8).
#
# Unset here (local/harness runs) means no budget and the previous
# behaviour exactly; the job runner applies a default of 420 s.
#ADJUDICATION_BUDGET_SECONDS=420

# ---------------------------------------------------------------------------
# Per-role transport tuning. All optional; the defaults are what every
# measured run used, and none of these needs setting to run the project.
# Listed because they are read at runtime, and an env var that changes
# behaviour without appearing here is a trap for the next operator.
# ---------------------------------------------------------------------------
# How many times a role re-asks after a response that parsed but did not meet
# the contract, and how long it waits between those tries. Distinct from the
# SDK's own transport retries, which handle 429/5xx.
#SCHEMA_MAPPER_CONTRACT_RETRIES=
#SCHEMA_MAPPER_CONTRACT_RETRY_SECONDS=
#SCHEMA_MAPPER_TRANSPORT_RETRY_SECONDS=
#SCHEMA_MAPPER_MAX_OUTPUT_TOKENS=
#RECORD_VERIFIER_CONTRACT_RETRIES=
#RECORD_VERIFIER_CONTRACT_RETRY_SECONDS=
#RECORD_VERIFIER_TRANSPORT_RETRY_SECONDS=

# Neon's unpooled endpoint, injected by the Vercel integration alongside
# DATABASE_URL. Never set by hand on the deployed target and never
# overwritten there — it is integration-managed. Locally it is unused.
#DATABASE_URL_UNPOOLED=

# Upload guards, enforced before any byte reaches the pipeline. Note that on
# both deployed targets a SMALLER platform body limit fires first (~4.5 MB on
# Vercel, measured; ~4.4 MB on API Gateway + Lambda, derived), so this cap is
# only the binding one locally — see the README's Honest limitations.
#MAX_UPLOAD_BYTES=10485760
#MAX_PAGES=25

# Vision-OCR adapter (ADR 010). All optional: each falls back to the shared
# ANTHROPIC_* names, the same chain the verifier and adjudicator use. Setting
# a model here is how OCR runs a cheaper model than schema mapping — reading a
# page is a much smaller task than deciding what its cells mean.
#
# NOTE the key chain: VISION_OCR_API_KEY -> ANTHROPIC_API_KEY. It does NOT
# fall back to SCHEMA_MAPPER_API_KEY, so a deployment whose only credential
# lives in SCHEMA_MAPPER_API_KEY must set VISION_OCR_API_KEY explicitly or the
# scanned path fails closed at config time. That is the correct failure — but
# it is a surprise if you have not read this line (ADR 010 addendum).
#
# Access-probed 2026-08-27 against the AI Gateway on the free tier:
# `zai/glm-5.3-flash` is vision-capable and transcribed a rendered tax-table
# fragment exactly. It is the same id the mapper ran for all six gate runs, so
# it raises no new entitlement question. ALWAYS set the two price variables
# alongside the model — a role with a MODEL and no USD_PER_MTOK_* is reported
# at the Opus defaults, which would overstate OCR cost by ~30x.
#VISION_OCR_API_KEY=
#VISION_OCR_BASE_URL=https://ai-gateway.vercel.sh
#VISION_OCR_MODEL=zai/glm-5.3-flash
#VISION_OCR_USD_PER_MTOK_IN=0.15
#VISION_OCR_USD_PER_MTOK_OUT=0.5
#VISION_OCR_MAX_OUTPUT_TOKENS=16000

# Injected by Vercel; listed so the self-kick's requirements are documented
# rather than discovered. VERCEL_URL is the deployment host (no scheme; https
# is prepended, never http — the bearer must not cross the wire in clear).
# SELF_BASE_URL overrides it for local runs. The bypass secret is only needed
# while a preview sits behind Deployment Protection.
#SELF_BASE_URL=
#VERCEL_AUTOMATION_BYPASS_SECRET=
